{
  "name": "opencode-token-tracker",
  "version": "2.0.0",
  "description": "Real-time token usage and cost tracking plugin for OpenCode with Toast notifications and CLI stats",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "bin": {
    "opencode-tokens": "dist/bin/opencode-tokens.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run build",
    "release:check": "node scripts/release.js check",
    "release:prepare": "node scripts/release.js prepare",
    "release:tag": "node scripts/release.js tag"
  },
  "keywords": [
    "opencode",
    "plugin",
    "token",
    "usage",
    "cost",
    "tracking",
    "ai",
    "llm",
    "claude",
    "gpt",
    "anthropic",
    "openai"
  ],
  "author": "tongsh6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tongsh6/opencode-token-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/tongsh6/opencode-token-tracker/issues"
  },
  "homepage": "https://github.com/tongsh6/opencode-token-tracker#readme",
  "dependencies": {
    "@opencode/plugin": "2.0.25"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/tui.js",
    "dist/tui.d.ts",
    "dist/lib",
    "dist/bin",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
